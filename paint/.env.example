PORT=8788
HOST=127.0.0.1
PUBLIC_BASE_URL=https://paint.jianshuo.dev
DATA_DIR=/opt/paint/data
API_TOKEN=replace-with-long-random-token
CALLBACK_SIGNING_SECRET=replace-with-long-random-secret
# 本进程同时最多执行几张（兜底；真正的并发闸门在 engine-router 的 concurrency.image_*）
MAX_CONCURRENCY=8
RETENTION_DAYS=30
GPT_IMAGE_BIN=gpt-image-2-skill
CODEX_HOME=/opt/paint/.codex
CODEX_MODELS=gpt-5.4-mini,gpt-5.4
MAX_INPUT_BYTES=26214400
MAX_PROMPT_CHARS=4000

# —— 火山方舟 Seedream（engine-router 把批次派给 seedream 时用；2026-10-28 起不再自动降级）——
# 没有 ARK_API_KEY：engine=seedream 提交即 400。
ARK_API_KEY=replace-with-ark-api-key
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODELS=doubao-seedream-5-0-pro-260628,doubao-seedream-4-0-20260415
# SEEDREAM_TIMEOUT_MS=180000
# SEEDREAM_MIN_PIXELS=921600
CONVERT_BIN=/usr/bin/convert

# —— 时间预算（一般不用改，见 USAGE.md「时间」）——
# JOB_DEADLINE_MS=480000            # 一张图的执行期限（从开画算，排队不算）
# RATE_LIMIT_RETRY_MS=15000,30000   # 瞬时 429 原地重试的等待序列
# CLAIM_INTERVAL_MS=2000            # 空闲时多久向 engine-router 领一次活

# —— engine-router（必配）：出图批次的调度（一批一个引擎、group 统一引擎、按账号并发排队、额度冷却）全在它那里 ——
ROUTER_URL=https://lab.jianshuo.dev/router
ROUTER_TOKEN=                       # engine-router .env 的 ROUTER_TOKENS 里 paint 那一项
