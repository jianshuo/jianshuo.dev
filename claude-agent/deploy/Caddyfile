# Caddy reverse proxy: HTTPS (auto Let's Encrypt) + single-password gate.
# Replace the bcrypt hash below with output of: caddy hash-password
# (provisioning script does this automatically).

lab.jianshuo.dev {
	encode gzip
	# 请求体上限在门口就卡：/api/book 匿名可达，node 侧另有 256KB 上限（server.ts），
	# 这里让 Caddy 先答 413，免得 node 中途关连接被 Caddy 报成 502。
	request_body {
		max_size 2MB
	}

	# /api/book* 走 App 自己的 VoiceDrop bearer（服务端扣费即准入），豁免密码门。
	# /api/video-book* 是书架「动画版」：任何人可触发（像听书），闸在 src/video-book.ts（只做写完的书、一次一本、每天限量）。
	@needsauth not path /api/book /api/book/* /api/video-book /api/video-book/*
	basic_auth @needsauth {
		wjs REPLACE_WITH_BCRYPT_HASH
	}

	reverse_proxy 127.0.0.1:8787 {
		flush_interval -1
	}
}
