#!/usr/bin/env node
// paint — 出图的唯一命令行入口（调本机 paint 服务 127.0.0.1:8788，即 paint.jianshuo.dev）。
// 完整说明书：paint/USAGE.md；agent 版：skills/paint/SKILL.md。
//
//   文生图:  paint "提示词" 输出.jpg
//   改图:    paint "提示词" 输出.jpg --image 输入.jpg
//   选项:    --size WxH(默认1024x1024，任意合理比例，服务端自动规整) --transparent
//            --quality low|medium|high --format png|jpeg|webp --compression 0-100
//            --engine auto|codex|seedream（默认 auto）  --group <书的slug>（同组统一画风）
//   查引擎:  paint --engines a.jpg b.jpg …   （读图里 XMP，报每张是 codex 还是 seedream + 少数派）
//
// 格式不给就按输出扩展名定；jpeg/webp 不给 --compression 一律 80。
// 成功：stdout 打 saved / result_url / engine / job，退出 0。
// 失败：stderr 打「paint job failed: <code>: <message>」，退出 1。最长等 9 分钟（服务端整单期限 8 分钟）。
import { paintOne, formatError, engineLine, engineOfFile, engineTally } from "./paint-client.mjs";

const USAGE = 'usage: paint "prompt" out.jpg [--image in.jpg] [--size WxH] [--transparent] [--quality q] [--format f] [--compression n] [--engine auto|codex|seedream] [--group slug]\n       paint --engines file…';
const argv = process.argv.slice(2);

if (argv[0] === "--engines") {
  const files = argv.slice(1);
  if (!files.length) { console.error(USAGE); process.exit(2); }
  for (const f of files) console.log(`${(engineOfFile(f) ?? "unknown").padEnd(8)} ${f}`);
  const t = engineTally(files);
  console.log(`— codex ${t.counts.codex} / seedream ${t.counts.seedream} / unknown ${t.counts.unknown}` +
    (t.minority.length ? `；混用了！多数是 ${t.majority}，少数派要用 --engine ${t.majority} 重画：${t.minority.join(" ")}` : "；画风引擎一致"));
  process.exit(0);
}

const [prompt, out, ...rest] = argv;
if (!prompt || !out) { console.error(USAGE); process.exit(2); }

const VALUED = { "--image": "image", "--size": "size", "--quality": "quality", "--format": "format", "--compression": "compression", "--engine": "engine", "--group": "group" };
const opts = { prompt, out };
for (let i = 0; i < rest.length; i++) {
  const a = rest[i];
  if (a === "--transparent") opts.transparent = true;
  else if (VALUED[a] && i + 1 < rest.length) opts[VALUED[a]] = rest[++i];
  else { console.error(`unknown option: ${a}\n${USAGE}`); process.exit(2); }
}

let lastStatus = "";
const r = await paintOne(opts, (j) => {
  if (j.status === "submitted") console.error(`job ${j.job_id} submitted, waiting...`);
  else if (j.status !== lastStatus) console.error(`  ${j.status}...`);
  lastStatus = j.status;
});

if (r.ok) {
  console.log(`saved: ${r.out}`);
  console.log(`result_url: ${r.result_url}`);
  console.log(engineLine(r));
  console.log(`job: ${r.job_id} (${Math.round(r.secs)}s)`);
  process.exit(0);
}
console.error(`paint job failed: ${formatError(r.error)}${r.job_id ? ` (job ${r.job_id}${r.engine ? `, ${engineLine(r)}` : ""})` : ""}`);
process.exit(1);
